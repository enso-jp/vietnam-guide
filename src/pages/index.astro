---
import Base from '../layouts/Base.astro';
import BookStay from '../components/BookStay.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import VietnamMap from '../components/VietnamMap.astro';
import { interestHref, interestLabels, site } from '../config/site';
import interestPhotos from '../content/interest-photos.json';
import { attractionsForInterest, corridorsNorthToSouth, getHighlights, getOtherPosts, placePath, placesForInterest, placesInCorridor } from '../lib/content';
import { photoPath } from '../lib/photos';
import type { Place } from '../lib/types';
import { vietnamRegions } from '../lib/vietnam-map';

const photos = interestPhotos as Record<string, string>;
const highlights = getHighlights();
const stories = getOtherPosts();
const lead = highlights[0];
const sheet = highlights.slice(1, 4);
const feature = highlights[4];
const corridors = corridorsNorthToSouth();
const activeRegion = corridors[0]?.slug;
const regionLabel = new Map(vietnamRegions.map((region) => [region.slug, region.name]));
const stackFor = (slug: string) => {
  const used = new Set<string>();
  const picks: Place[] = [];
  for (const place of placesInCorridor(slug)) {
    const src = photoPath(place.slug);
    if (!src || used.has(src)) continue;
    used.add(src);
    picks.push(place);
    if (picks.length === 5) break;
  }
  return picks;
};
const interestOrder = ['food', 'beaches', 'caves', 'pagodas', 'rice', 'oldTowns', 'markets', 'warHistory', 'mountains', 'coffee', 'islands', 'nightlife', 'family', 'photography', 'motorbike'];
const interests = interestOrder
  .filter((key) => key === 'food' || placesForInterest(key).length > 0 || attractionsForInterest(key).length > 0)
  .slice(0, 8)
  .map((key) => {
    const place = placesForInterest(key)[0];
    return {
      key,
      href: interestHref(key),
      label: key === 'food' ? 'Food and drink' : interestLabels[key],
      photo: photos[key] || place?.slug || 'hanoi',
      cover: 'town',
    };
  });
const tools = [
  { href: '/plan/when-to-go', title: 'Before you go', text: 'Things to know before you depart', icon: 'ticket' },
  { href: '/get-there', title: 'Transportation', text: 'Routes, trains, flights, and buses', icon: 'bus' },
  { href: '/plan/where-to-stay', title: 'Accommodation', text: 'Choose where to stay overnight', icon: 'bed' },
  { href: '/itineraries', title: 'Itinerary ideas', text: 'Inspiration for your own trip plan', icon: 'trip' },
  { href: '/plan/street-manners', title: 'Etiquette', text: 'How to avoid cultural mistakes', icon: 'flag' },
  { href: '/seasons', title: 'Seasons', text: 'Rice, floods, and Tet', icon: 'event' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.url}/search?q={query}`,
    'query-input': 'required name=query',
  },
};
---
<Base title="Vietnam Guide" description={site.description} path="/" jsonLd={jsonLd} ogType="website" ogImage={photoPath(lead?.photo || 'hanoi')}>
  <div class="home">
    <div class="home-top">
      {lead && (
        <a class="home-hero home-hero-lead" href={lead.href}>
          <Photo id={lead.photo} alt="" cover={lead.cover} priority />
          <span class="home-hero-copy">
            <small><i class="hero-mark" aria-hidden="true"></i>{lead.kicker}</small>
            <h1>{lead.title}</h1>
            <em><Icon name="clock" />{lead.when}</em>
            <span class="pill pill-light">See the guide</span>
          </span>
        </a>
      )}

      {sheet.length > 0 && (
        <section class="home-sheet" aria-label="More guides">
          <div class="sheet-rail" data-carousel>
            <div class="sheet-row" data-carousel-row tabindex="0">
              {sheet.map((story) => (
                <a class="mini-card" href={story.href}>
                  <span class="media"><Photo id={story.photo} alt="" cover={story.cover} /></span>
                  <span class="story-copy">
                    <small class:list={{ 'kicker-season': story.kicker === 'Season' }}>{story.kicker}</small>
                    <strong>{story.title}</strong>
                    <em>{story.when}</em>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <div class="home-split">
        {feature && (
          <a class="home-hero home-hero-next" href={feature.href}>
            <Photo id={feature.photo} alt="" cover={feature.cover} />
            <span class="home-hero-copy">
              <small><i class="hero-mark" aria-hidden="true"></i>{feature.kicker}</small>
              <strong>{feature.title}</strong>
              <em>{feature.when}</em>
            </span>
          </a>
        )}

        <div class="home-rail">
          <BookStay />
        </div>

        <div class="home-feed">
          {stories.length > 0 && (
            <section class="home-stories" id="stories">
              <h2>Stories</h2>
              <div class="story-list">
                {stories.map((story) => (
                  <a class="story-row" href={story.href}>
                    <span class="story-copy">
                      <small class:list={{ 'kicker-season': story.kicker === 'Season' }}>{story.kicker}</small>
                      <strong>{story.title}</strong>
                      <em>{story.when}</em>
                      <p>{story.summary}</p>
                    </span>
                    <span class="media"><Photo id={story.photo} alt="" cover={story.cover} /></span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <div class="home-actions lead-actions">
            <a class="pill" href="/seasons">Season alerts</a>
            <a class="pill" href="/blog">See more stories</a>
          </div>
        </div>
      </div>
    </div>

    <section class="home-section region-stage" data-region-stage>
      <h2>Regions of Vietnam</h2>
      <div class="region-board">
        <div class="region-map">
          <div class="region-map-frame">
            <VietnamMap variant="home" active={activeRegion} names={false} />
            <div class="map-tooltip" data-map-tooltip hidden>
              <span class="map-tooltip-region" data-map-tooltip-region></span>
              <strong class="map-tooltip-place" data-map-tooltip-place></strong>
            </div>
          </div>
          <div class="region-picks" role="tablist" aria-label="Regions">
            {corridors.map((corridor) => (
              <button
                type="button"
                role="tab"
                data-region={corridor.slug}
                aria-selected={corridor.slug === activeRegion ? 'true' : 'false'}
                class:list={[{ 'is-active': corridor.slug === activeRegion }]}
              >
                {regionLabel.get(corridor.slug) || corridor.name}
              </button>
            ))}
          </div>
        </div>
        <div class="region-stack">
          {corridors.map((corridor) => {
            const places = stackFor(corridor.slug);
            return (
              <div class="region-panel" data-region-card={corridor.slug} hidden={corridor.slug !== activeRegion}>
                <div class="region-photos">
                  {places.map((place) => (
                    <a href={placePath(place)}>
                      <Photo id={place.slug} alt="" cover={place.cover} />
                      <span>{place.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <div class="region-caption">
        {corridors.map((corridor) => (
          <div class="region-caption-panel" data-region-card={corridor.slug} hidden={corridor.slug !== activeRegion}>
            <h3>{corridor.name}</h3>
            <p>{corridor.summary}</p>
          </div>
        ))}
      </div>
      <p class="region-more"><a class="pill" href="/destinations">See regions</a></p>
    </section>

    <section class="home-section">
      <h2>Plan your trip</h2>
      <div class="plan-row">
        {tools.map((tool) => (
          <a href={tool.href}>
            <span class="plan-icon"><Icon name={tool.icon} /></span>
            <strong>{tool.title}</strong>
            <span>{tool.text}</span>
          </a>
        ))}
      </div>
      <p class="home-actions"><a class="pill" href="/plan">See all planning tools</a></p>
    </section>

    <section class="home-section">
      <h2>Find your interest</h2>
      <div class="interest-grid">
        {interests.map((item) => (
          <a class="home-tile" href={item.href}>
            <Photo id={item.photo} alt="" cover={item.cover} />
            <span>{item.label}</span>
          </a>
        ))}
      </div>
      <p class="home-actions"><a class="pill" href="/interests">See all interests</a></p>
    </section>

  </div>
</Base>
