---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import SectionNav from '../../components/SectionNav.astro';
import TripOtherStay from '../../components/TripOtherStay.astro';
import { getPlace, getResortShowcases, pageDescription, placePath } from '../../lib/content';
import type { ResortProperty } from '../../lib/types';
import { photoPath } from '../../lib/photos';
import { article, breadcrumbList } from '../../lib/schema';

export function getStaticPaths() {
  return getResortShowcases().map((showcase) => ({
    params: { slug: showcase.slug },
    props: { showcase },
  }));
}

const { showcase } = Astro.props;
const place = getPlace(showcase.placeSlug);
const title = showcase.seoTitle;
const description = pageDescription(showcase.seoDescription, showcase.summary);
const path = `/resort-living/${showcase.slug}`;
const image = photoPath(showcase.properties[0]?.photo || place?.slug || '');
const creditsPath = join(process.cwd(), 'public', 'photos', 'credits.json');
const credits: Record<string, { author?: string; license?: string }> = existsSync(creditsPath)
  ? JSON.parse(readFileSync(creditsPath, 'utf8'))
  : {};

function areaId(heading: string): string {
  return heading
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'resorts';
}

const groups: { id: string; heading: string; properties: ResortProperty[] }[] = [];
for (const property of showcase.properties) {
  const heading = property.area || 'Resorts';
  const id = areaId(heading);
  const last = groups.at(-1);
  if (last && last.id === id) last.properties.push(property);
  else groups.push({ id, heading, properties: [property] });
}
const crumbSchema = [
  { name: 'Interests', path: '/interests' },
  { name: 'Resort Living', path: '/interests/resort-living' },
  { name: showcase.name, path },
];
---
<Base title={title} description={description} path={path} jsonLd={[article(title, description, path, image), breadcrumbList(crumbSchema)]} ogImage={image}>
  <article class="wrap section">
    <Crumbs items={[
      { name: 'Interests', href: '/interests' },
      { name: 'Resort Living', href: '/interests/resort-living' },
      { name: showcase.name },
    ]} />
    <h1>{showcase.name}</h1>
    <p class="lede">{showcase.summary}</p>
    <SectionNav label={`${showcase.name} coasts`} items={groups.map((group) => ({ id: group.id, label: group.heading }))} />
    <div class="reading place-body">
      {showcase.body.map((paragraph) => <p>{paragraph}</p>)}
      <p class="note">Each name is on the operator’s public site. Rates are not listed here.</p>
      {groups.map((group) => (
        <section id={group.id} class="place-section">
          <h2>{group.heading}</h2>
          <div class="resort-grid">
            {group.properties.map((property) => (
              <article class="food-card">
                <span class="media"><Photo id={property.photo} alt={property.name} /></span>
                <strong>{property.name}</strong>
                <em>{property.summary}</em>
                <small>
                  Source: {property.sources.map((source, index) => (
                    <>
                      {index > 0 && '; '}
                      <a href={source.url} rel="noopener noreferrer">{source.label}</a>
                    </>
                  ))}
                </small>
                {credits[property.photo] && <small class="photo-credit">Photo: {credits[property.photo].author} · {credits[property.photo].license}</small>}
              </article>
            ))}
          </div>
        </section>
      ))}
      {place && <p><a href={placePath(place)}>{place.name} travel guide</a></p>}
    </div>
    <aside class="stay-box">
      <h2>Book your <em>stay</em></h2>
      <TripOtherStay />
    </aside>
  </article>
</Base>
