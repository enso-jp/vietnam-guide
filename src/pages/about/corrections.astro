---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
---
<Base title="Corrections" description="Fees, hours, and visa rules go stale. If a fact is wrong, note the page and the field. Editors correct the JSON record and stamp a new verified date." path="/about/corrections">
  <article class="wrap reading section">
    <h1>Corrections</h1>
    <p>Fees, hours, and visa rules go stale. If a fact is wrong, note the page and the field.</p>
    {site.correctionsEmail ? (
      <p><a href={`mailto:${site.correctionsEmail}`}>Email a correction</a></p>
    ) : (
      <p>No public inbox is set yet. Editors correct the JSON record for that page and stamp a new verified date. Set <code>correctionsEmail</code> in <code>src/config/site.ts</code> when you want this page to open a mail draft.</p>
    )}
  </article>
</Base>
