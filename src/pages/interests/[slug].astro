---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import SectionNav from '../../components/SectionNav.astro';
import TripOtherStay from '../../components/TripOtherStay.astro';
import { interestHref, interestKeyFromSlug, interestLabels, interestPublicSlug } from '../../config/site';
import interestPhotos from '../../content/interest-photos.json';
import { getInterestCopy, pageDescription } from '../../lib/content';
import { interestSections } from '../../lib/interest-page';
import { photoPath } from '../../lib/photos';
import { breadcrumbList, itemList } from '../../lib/schema';

export function getStaticPaths() {
  return Object.entries(interestLabels).map(([key, label]) => ({
    params: { slug: interestPublicSlug[key] ?? key },
    props: { key, label },
  }));
}

const { slug } = Astro.params;
const key = interestKeyFromSlug(slug ?? '') ?? Astro.props.key;
const label = key === 'food' ? 'Food and drink' : (interestLabels[key] ?? Astro.props.label);
const copy = getInterestCopy(key);
const description = pageDescription(copy?.summary || `${label} in Vietnam.`, ...(copy?.body || []));
const path = interestHref(key);
const photos = interestPhotos as Record<string, string>;
const heroId = photos[key] && photoPath(photos[key]) ? photos[key] : '';
const sections = interestSections(key);
const creditsPath = join(process.cwd(), 'public', 'photos', 'credits.json');
const credits: Record<string, { author?: string; license?: string }> = existsSync(creditsPath)
  ? JSON.parse(readFileSync(creditsPath, 'utf8'))
  : {};
const heroCredit = heroId ? credits[heroId] : undefined;
const listed = sections.flatMap((section) => [
  ...section.cards.map((card) => ({ name: card.title, path: card.href })),
  ...section.text.map((item) => ({ name: item.title, path: item.href })),
]);
const jsonLd = [
  itemList(label, listed),
  breadcrumbList([
    { name: 'Interests', path: '/interests' },
    { name: label, path },
  ]),
];

function stars(dots: number): string {
  const filled = Math.max(0, Math.min(5, dots));
  return Array.from({ length: 5 }, (_, index) => (index < filled ? '★' : '☆')).join('');
}
---
<Base title={`${label} in Vietnam`} description={description} path={path} ogType="website" jsonLd={jsonLd} ogImage={heroId ? photoPath(heroId) : undefined}>
  <article class="wrap section">
    <Crumbs items={[{ name: 'Interests', href: '/interests' }, { name: label }]} />
    <h1>{label}</h1>
    {copy?.summary && <p class="lede">{copy.summary}</p>}
    {heroId && (
      <figure class="prose-figure">
        <Photo id={heroId} alt={label} priority={true} />
        {heroCredit?.author && <figcaption>Photo: {heroCredit.author} · {heroCredit.license}</figcaption>}
      </figure>
    )}
    {copy?.verified && <p class="note">Facts verified {copy.verified}. Fees and hours change; confirm before you go.</p>}
    <SectionNav label={`${label} sections`} items={sections.map((section) => ({ id: section.id, label: section.heading }))} />
    <div class="reading place-body">
      {copy?.body.map((paragraph) => <p>{paragraph}</p>)}
      {sections.map((section) => (
        <section id={section.id} class="place-section">
          <h2>{section.heading}</h2>
          {section.cards.length > 0 && (
            <div class={section.food ? 'food-grid' : 'jg-grid'}>
              {section.cards.map((card, index) => section.food ? (
                <a class="food-card" href={card.href}>
                  <span class="media"><Photo id={card.photo} alt={card.alt} /></span>
                  <strong>{card.title}{card.nameVi && <> <span class="vi" lang="vi">{card.nameVi}</span></>}</strong>
                  <em>{card.line}</em>
                </a>
              ) : (
                <a class="jg-card" href={card.href}>
                  <div class="media">
                    <Photo id={card.photo} alt={card.alt} />
                    <span class="rank-badge">{index + 1}</span>
                  </div>
                  <div class="jg-body">
                    <h3>
                      {card.title}
                      {card.nameVi && <span class="vi" lang="vi"> {card.nameVi}</span>}
                      {(card.dots ?? 0) >= 4 && <span class="mark" aria-hidden="true"></span>}
                    </h3>
                    <p>{card.line}</p>
                    {card.dots != null && (
                      <p class="rating">
                        <span class="score">{card.dots.toFixed(1)}</span>
                        <span class="stars" aria-label={`${card.dots} of 5, editor rating`}>{stars(card.dots)}</span>
                        <span class="note">Editor</span>
                      </p>
                    )}
                    {card.meta && <p class="meta">{card.meta}</p>}
                  </div>
                </a>
              ))}
            </div>
          )}
          {section.text.length > 0 && (
            <ul class="guide-list">
              {section.text.map((item) => (
                <li>
                  <a class="guide-row" href={item.href}>
                    <strong>{item.title}{item.nameVi && <> <span class="vi" lang="vi">{item.nameVi}</span></>}</strong>
                    <p>{item.line}</p>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
    <aside class="stay-box">
      <h2>Book your <em>stay</em></h2>
      <TripOtherStay />
    </aside>
  </article>
</Base>
