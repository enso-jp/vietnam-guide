---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import { interestHref, interestLabels } from '../../config/site';
import interestPhotos from '../../content/interest-photos.json';
import { attractionsForInterest, placesForInterest } from '../../lib/content';
import { breadcrumbList, itemList } from '../../lib/schema';

const groups: { title: string; keys: string[] }[] = [
  { title: 'Food and the street', keys: ['food', 'markets', 'coffee', 'nightlife'] },
  { title: 'Coast and islands', keys: ['beaches', 'islands', 'resortLiving'] },
  { title: 'Towns and temples', keys: ['oldTowns', 'pagodas'] },
  { title: 'Land and caves', keys: ['caves', 'rice', 'mountains'] },
  { title: 'History and the road', keys: ['warHistory', 'photography', 'motorbike', 'family'] },
];
const photos = interestPhotos as Record<string, string>;
const shown = groups
  .map((group) => ({
    ...group,
    items: group.keys
      .filter((key) => key === 'food' || placesForInterest(key).length > 0 || attractionsForInterest(key).length > 0)
      .map((key) => ({
        key,
        href: interestHref(key),
        label: key === 'food' ? 'Food and drink' : interestLabels[key],
        photo: photos[key],
      })),
  }))
  .filter((group) => group.items.length > 0);
const description = 'Browse Vietnam by food, beaches, old towns, pagodas, caves, markets, and the other reasons to plan a stop.';
---
<Base title="Interests" description={description} path="/interests" ogType="website" jsonLd={[itemList('Interests', shown.flatMap((group) => group.items.map((item) => ({ name: item.label, path: item.href })))), breadcrumbList([{ name: 'Interests', path: '/interests' }])]}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Interests' }]} />
    <p class="eyebrow">Explore your interests</p>
    <h1>Interests</h1>
    <p class="lede">Each tile is one subject. A place can sit in more than one list. Food is a guide to dishes, not a destination list.</p>
    {shown.map((group) => (
      <section class="place-section">
        <h2>{group.title}</h2>
        <div class="interest-grid">
          {group.items.map((item) => (
            <a class="home-tile" href={item.href}>
              <Photo id={item.photo} alt="" />
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
