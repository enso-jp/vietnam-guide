---
import Base from '../../layouts/Base.astro';
import { interestHref, interestLabels } from '../../config/site';
import { attractionsForInterest, placesForInterest } from '../../lib/content';
import { breadcrumbList, itemList } from '../../lib/schema';

import Crumbs from '../../components/Crumbs.astro';

const interests = Object.entries(interestLabels)
  .filter(([key]) => key !== 'food')
  .map(([key, label]) => ({
    key,
    label,
    href: interestHref(key),
    count: placesForInterest(key).length,
    sights: attractionsForInterest(key).length,
  }))
  .filter((item) => item.count > 0 || item.sights > 0);
const description = 'Browse Vietnam by beaches, caves, rice scenery, pagodas, and the other reasons to plan a stop. Food is a dish guide, not a destination list.';
---
<Base title="Interests" description={description} path="/interests" ogType="website" jsonLd={[itemList('Interests', interests.map((item) => ({ name: item.label, path: item.href }))), breadcrumbList([{ name: 'Interests', path: '/interests' }])]}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Interests' }]} />
    <h1>Browse by interest</h1>
    <p class="lede">Destination lists, grouped by why you would go. A place can sit in more than one list. Food is a guide to dishes, not a destination list.</p>
    <div class="hub-grid">
      <a href="/food">
        <h2>Food</h2>
        <p class="meta">Dish guides and city food guides</p>
      </a>
      {interests.map((interest) => (
        <a href={interest.href}>
          <h2>{interest.label}</h2>
          <p class="meta">{interest.sights} {interest.sights === 1 ? 'sight' : 'sights'} · {interest.count} {interest.count === 1 ? 'place' : 'places'}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
