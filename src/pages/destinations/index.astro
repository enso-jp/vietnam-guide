---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Dots from '../../components/Dots.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import VietnamMap from '../../components/VietnamMap.astro';
import { cardLine, compareRecommended, corridorsNorthToSouth, getPlaces, pageDescription, placePath, placesInCorridor } from '../../lib/content';
import { breadcrumbList, itemList } from '../../lib/schema';

const corridors = corridorsNorthToSouth();
const places = getPlaces().filter((place) => !place.parent).sort(compareRecommended);
const mainPlaces = places.slice(0, 9);
const description = pageDescription(
  'Five travel corridors from northern Vietnam to the Mekong Delta, then the main places in each.',
  'Province borders changed in 2025. The place names did not.',
);
---
<Base title="Destinations" description={description} path="/destinations" ogType="website" jsonLd={[itemList('Destinations', places.map((place) => ({ name: place.name, path: placePath(place) }))), breadcrumbList([{ name: 'Destinations', path: '/destinations' }])]}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Destinations' }]} />
    <p class="eyebrow">Find your destination</p>
    <h1>Destinations</h1>
    <p class="lede">Five corridors, from the northern mountains to the Mekong. Province borders changed in 2025. The place names did not.</p>

    <section class="atlas" aria-label="Regions">
      <div class="atlas-cards">
        {corridors.map((corridor) => (
          <a class="atlas-card" href={`/destinations/${corridor.slug}`}>
            <p class="explore-kicker">Region</p>
            <h2>{corridor.name}</h2>
            <p>{corridor.summary}</p>
          </a>
        ))}
      </div>
      <VietnamMap variant="home" />
    </section>

    <section class="place-section">
      <h2>Places</h2>
      <div class="jg-grid">
        {mainPlaces.map((place, index) => (
          <PlaceCard place={place} rank={index + 1} />
        ))}
      </div>
    </section>

    {corridors.map((corridor) => {
      const list = placesInCorridor(corridor.slug);
      if (!list.length) return null;
      return (
        <section class="place-section corridor-index">
          <h2><a href={`/destinations/${corridor.slug}`}>{corridor.name}</a></h2>
          <ul>
            {list.map((place) => (
              <li>
                <a class="place-name" href={placePath(place)}>{place.name}</a>
                <Dots dots={place.dots} />
                <p>{cardLine(place.summary)}</p>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
