---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ItineraryIndexCard from '../../components/ItineraryIndexCard.astro';
import PlanTabs from '../../components/PlanTabs.astro';
import { corridorsNorthToSouth, getItineraries } from '../../lib/content';
import { buildItineraryIndex, compareItineraryTitle, durationChoices } from '../../lib/itinerary-index';
import { titles } from '../../lib/page-title';
import { breadcrumbList, itemList } from '../../lib/schema';
import type { Itinerary } from '../../lib/types';

const trips = getItineraries();
const index = buildItineraryIndex(trips);
const nationwideTrips = trips.filter((trip) => trip.level === 'nationwide' && trip.daysCount != null);
const nationwideChoices = durationChoices(nationwideTrips);
const regionTrips = trips.filter((trip): trip is Itinerary & { corridor: string; daysCount: number } => (
  trip.level === 'region' && Boolean(trip.corridor) && trip.daysCount != null
));
const regionOptions = corridorsNorthToSouth().filter((corridor) => regionTrips.some((trip) => trip.corridor === corridor.slug));
const defaultRegion = regionOptions[0]?.slug || '';
const regionChoices = durationChoices(regionTrips.filter((trip) => trip.corridor === defaultRegion));

function tripRow(trip: Itinerary) {
  return { slug: trip.slug, title: trip.title, duration: trip.duration, daysCount: trip.daysCount };
}

const catalog = {
  nationwide: {
    choices: nationwideChoices,
    trips: [...nationwideTrips].sort(compareItineraryTitle).map(tripRow),
  },
  regions: regionOptions.map((corridor) => {
    const matching = regionTrips.filter((trip) => trip.corridor === corridor.slug);
    return {
      slug: corridor.slug,
      choices: durationChoices(matching),
      trips: [...matching].sort(compareItineraryTitle).map(tripRow),
    };
  }),
};
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
const description = 'Nationwide routes, corridor trips, and timed city walks for Vietnam. Each trip is a sequence of places already on this site.';
---
<Base title={titles.itineraries} description={description} path="/itineraries" ogType="website" jsonLd={[itemList('Itineraries', trips.map((trip) => ({ name: trip.title, path: `/itineraries/${trip.slug}` }))), breadcrumbList([{ name: 'Plan a trip', path: '/plan' }, { name: 'Itinerary ideas', path: '/itineraries' }])]}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Plan a trip', href: '/plan' }, { name: 'Itinerary ideas' }]} />
    <h1>Itinerary ideas</h1>
    <PlanTabs current="itineraries" />
    <div class="itinerary-index place-body">
      {index.nationwide.length > 0 && (
        <section class="itinerary-block itinerary-band" id="nationwide">
          <h2>Nationwide</h2>
          <div class="itinerary-cards">
            {index.nationwide.map((card) => <ItineraryIndexCard {...card} />)}
          </div>
          <form class="itinerary-picker" action="/itineraries#nationwide-results" method="get" data-itinerary-filter="nationwide">
            <div class="itinerary-filter">
              <label>Duration
                <select name="nationwide-days" data-filter-duration>
                  {nationwideChoices.map((choice) => (
                    <option value={choice.daysCount}>{choice.label}</option>
                  ))}
                </select>
              </label>
              <button type="submit">See itineraries</button>
            </div>
            <div id="nationwide-results"></div>
          </form>
        </section>
      )}
      {index.regional.length > 0 && (
        <section class="itinerary-block itinerary-band" id="regional">
          <h2>Regional</h2>
          <div class="itinerary-cards">
            {index.regional.map((card) => <ItineraryIndexCard {...card} />)}
          </div>
          <form class="itinerary-picker" action="/itineraries#regional-results" method="get" data-itinerary-filter="region">
            <div class="itinerary-filter">
              <label>Region
                <select name="region" data-filter-region>
                  {regionOptions.map((corridor) => (
                    <option value={corridor.slug}>{corridor.name}</option>
                  ))}
                </select>
              </label>
              <label>Duration
                <select name="region-days" data-filter-duration>
                  {regionChoices.map((choice) => (
                    <option value={choice.daysCount}>{choice.label}</option>
                  ))}
                </select>
              </label>
              <button type="submit">See itineraries</button>
            </div>
            <div id="regional-results"></div>
          </form>
        </section>
      )}
      {index.local.length > 0 && (
        <section class="itinerary-block itinerary-band" id="local">
          <h2>Local</h2>
          <div class="itinerary-cards">
            {index.local.map((card) => <ItineraryIndexCard {...card} />)}
          </div>
        </section>
      )}
    </div>
    <script type="application/json" id="itinerary-filter-data" set:html={catalogJson}></script>
    <script is:inline>
      (function () {
        var node = document.getElementById('itinerary-filter-data');
        if (!node || !node.textContent) return;
        var data = JSON.parse(node.textContent);
        var params = new URLSearchParams(location.search);

        function fillDuration(select, choices, preferred) {
          var previous = preferred == null ? select.value : String(preferred);
          select.replaceChildren();
          choices.forEach(function (choice) {
            var option = document.createElement('option');
            option.value = String(choice.daysCount);
            option.textContent = choice.label;
            select.append(option);
          });
          if (choices.some(function (choice) { return String(choice.daysCount) === previous; })) {
            select.value = previous;
          }
        }

        function renderShortlist(host, trips) {
          host.replaceChildren();
          if (!trips.length) return;
          var list = document.createElement('ul');
          list.className = 'itinerary-shortlist';
          trips.forEach(function (trip) {
            var item = document.createElement('li');
            var link = document.createElement('a');
            link.href = '/itineraries/' + trip.slug;
            var title = document.createElement('strong');
            title.textContent = trip.title;
            var duration = document.createElement('small');
            duration.textContent = trip.duration;
            link.append(title, duration);
            item.append(link);
            list.append(item);
          });
          host.append(list);
        }

        var nationwideForm = document.querySelector('form[data-itinerary-filter="nationwide"]');
        var nationwideHost = document.getElementById('nationwide-results');
        var nationwideDays = params.get('nationwide-days');
        if (nationwideForm && nationwideHost && nationwideDays) {
          var nationwideSelect = nationwideForm.querySelector('[data-filter-duration]');
          var nationwideMatch = data.nationwide.choices.some(function (choice) {
            return String(choice.daysCount) === nationwideDays;
          });
          if (nationwideSelect && nationwideMatch) {
            nationwideSelect.value = nationwideDays;
            renderShortlist(nationwideHost, data.nationwide.trips.filter(function (trip) {
              return String(trip.daysCount) === nationwideDays;
            }));
          }
        }

        var regionForm = document.querySelector('form[data-itinerary-filter="region"]');
        var regionHost = document.getElementById('regional-results');
        if (regionForm && regionHost) {
          var regionSelect = regionForm.querySelector('[data-filter-region]');
          var regionDays = regionForm.querySelector('[data-filter-duration]');
          var requestedRegion = params.get('region');
          var requestedDays = params.get('region-days');
          function regionBySlug(slug) {
            return data.regions.find(function (region) { return region.slug === slug; });
          }
          if (regionSelect && regionDays) {
            var active = regionBySlug(requestedRegion) || regionBySlug(regionSelect.value);
            if (active) {
              regionSelect.value = active.slug;
              fillDuration(regionDays, active.choices, requestedRegion ? requestedDays : null);
              if (requestedRegion && requestedDays && active.choices.some(function (choice) {
                return String(choice.daysCount) === requestedDays;
              })) {
                renderShortlist(regionHost, active.trips.filter(function (trip) {
                  return String(trip.daysCount) === requestedDays;
                }));
              }
            }
            regionSelect.addEventListener('change', function () {
              var next = regionBySlug(regionSelect.value);
              if (next) fillDuration(regionDays, next.choices);
              regionHost.replaceChildren();
            });
          }
        }
      })();
    </script>
  </div>
</Base>
