---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import PlanTabs from '../../components/PlanTabs.astro';
import { attractionPath, getAttractions, getItineraries, getPlace, pageDescription, placePath } from '../../lib/content';
import { stayLink } from '../../lib/partners';
import { abs, breadcrumbList } from '../../lib/schema';

export function getStaticPaths() {
  return getItineraries().map((trip) => ({ params: { slug: trip.slug }, props: { trip } }));
}
const { trip } = Astro.props;
const days = (trip.days || []).map((day, index) => ({ ...day, id: `day-${index + 1}` }));
const placeFrom = (slug?: string) => (slug ? getPlace(slug) : undefined);
const firstPlace =
  days.map((day) => placeFrom(day.placeSlug)).find(Boolean)
  || (trip.stops || []).map((stop) => placeFrom(stop.placeSlug)).find(Boolean);
const otherTrips = getItineraries().filter((item) => item.slug !== trip.slug);
const path = `/itineraries/${trip.slug}`;
const description = pageDescription(trip.seoDescription, trip.summary);
const crumbSchema = [
  { name: 'Plan a trip', path: '/plan' },
  { name: 'Itinerary ideas', path: '/itineraries' },
  { name: trip.title, path },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: trip.title,
  description,
  url: abs(path),
  ...(days.length
    ? {
        itinerary: {
          '@type': 'ItemList',
          itemListElement: days.map((day, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: day.title,
            description: day.body,
          })),
        },
      }
    : {}),
};
---
<Base title={trip.seoTitle} description={description} path={path} jsonLd={[jsonLd, breadcrumbList(crumbSchema)]}>
  <article class="wrap section">
    <Crumbs items={[{ name: 'Plan a trip', href: '/plan' }, { name: 'Itinerary ideas', href: '/itineraries' }, { name: trip.title }]} />
    <h1>{trip.title}</h1>
    <PlanTabs current="itineraries" />
    <p class="lede">{trip.summary}</p>
    <div class="facts">
      <div><span>Duration</span><strong>{trip.duration}</strong></div>
      <div><span>Budget</span><strong>{trip.budget}</strong></div>
      <div><span>Pace</span><strong>{trip.pace}</strong></div>
    </div>
    <div class="place-grid itinerary-grid">
      <div class="day-list">
        {days.map((day, index) => {
          const place = day.placeSlug ? getPlace(day.placeSlug) : undefined;
          const photo = day.photo || place?.slug || '';
          const inner = (
            <>
              <span class="day-photo">
                <Photo id={photo} alt="" cover={place?.cover || 'city'} priority={index === 0} />
              </span>
              <span>
                <h2>{day.title}</h2>
                <p>{day.body}</p>
              </span>
            </>
          );
          return (
            <section id={day.id}>
              {place ? <a class="day-card" href={placePath(place)}>{inner}</a> : <div class="day-card">{inner}</div>}
            </section>
          );
        })}
    {trip.stops && (
      <section id="stops" class="place-section">
        <h2>Stops</h2>
        <ol class="rank-list">
          {trip.stops.map((stop) => {
            const attraction = stop.attractionSlug && stop.placeSlug
              ? getAttractions().find((item) => item.slug === stop.attractionSlug && item.placeSlug === stop.placeSlug)
              : undefined;
            const place = stop.placeSlug ? getPlace(stop.placeSlug) : undefined;
            const href = attraction
              ? attractionPath(attraction)
              : stop.dishSlug
                ? `/food/${stop.dishSlug}`
                : place
                  ? placePath(place)
                  : '';
            const photo = attraction
              ? `${attraction.placeSlug}-${attraction.slug}`
              : stop.dishSlug || stop.placeSlug || '';
            const body = (
              <>
                <span class="thumb">
                  <Photo id={photo} fallbackId={stop.placeSlug} alt="" cover={place?.cover} />
                </span>
                <span class="rank-copy">
                  <h3>{stop.name}</h3>
                  <p>{stop.note}</p>
                  <p class="meta">{stop.minutes} min{stop.walkMinutes ? ` · walk ${stop.walkMinutes} min` : ''}</p>
                </span>
              </>
            );
            return (
              <li>
                {href ? <a class="rank-row stop-row" href={href}>{body}</a> : <div class="rank-row stop-row">{body}</div>}
              </li>
            );
          })}
        </ol>
      </section>
    )}
      </div>
      <aside class="rail">
        {firstPlace && (
          <div class="panel stay-box">
            <h2>Book your <em>stay</em></h2>
            <ul class="stay-tabs">
              <li class="is-on"><span class="stay-tile"><Icon name="bed" /></span>Stays</li>
              <li><span class="stay-tile"><Icon name="plane" /></span>Flights</li>
              <li><span class="stay-tile"><Icon name="car" /></span>Car</li>
              <li><span class="stay-tile"><Icon name="bus" /></span>Buses</li>
              <li><span class="stay-tile"><Icon name="flag" /></span>Activities</li>
              <li><span class="stay-tile"><Icon name="food" /></span>Food</li>
            </ul>
            <p class="stay-field"><span>City</span><strong>{firstPlace.name}</strong></p>
            <p class="note">This is a placeholder until hotel listings are connected.</p>
            <a class="stay-btn" href={stayLink(firstPlace.name)} rel="sponsored noopener" target="_blank" data-partner="stay">Search stays</a>
          </div>
        )}
        {otherTrips.length > 0 && (
          <div class="panel">
            <p class="explore-kicker">Plan your trip</p>
            <h2>Itinerary ideas</h2>
            <ul class="explore-list">
              {otherTrips.map((item) => (
                <li><a href={`/itineraries/${item.slug}`}><Icon name="trip" />{item.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
