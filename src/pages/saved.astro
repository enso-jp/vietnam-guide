---
import Base from '../layouts/Base.astro';
import { getPlaces, placePath } from '../lib/content';
const catalog = getPlaces().map((place) => ({ id: place.slug, name: place.name, href: placePath(place) }));
---
<Base title="Saved places" description="Places you saved in this browser." path="/saved" noindex={true}>
  <div class="wrap section saved-page">
    <h1>Saved</h1>
    <ul id="saved-list"></ul>
    <script id="saved-catalog" type="application/json" set:html={JSON.stringify(catalog)} />
  </div>
</Base>
