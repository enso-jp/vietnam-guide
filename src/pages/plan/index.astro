---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import { getHighlights } from '../../lib/content';
import { photoPath } from '../../lib/photos';
import { titles } from '../../lib/page-title';
import { planSections } from '../../lib/plan-sections';
import { breadcrumbList } from '../../lib/schema';

const columns = planSections();

const shortSet = 6;
const creditsPath = join(process.cwd(), 'public', 'photos', 'credits.json');
const credits: Record<string, { license?: string }> = existsSync(creditsPath)
  ? JSON.parse(readFileSync(creditsPath, 'utf8'))
  : {};
const news = getHighlights().filter((story) => {
  const license = credits[story.photo]?.license?.trim();
  return Boolean(license && photoPath(story.photo));
});
---
<Base title={titles.plan} description="When to go, visas, where to stay, how to get around, itineraries, and living in Vietnam." path="/plan" jsonLd={breadcrumbList([{ name: 'Plan a trip', path: '/plan' }])}>
  <div class="plan-page">
    <div class="wrap section">
      <nav class="tabs" aria-label="Plan a trip">
        <a href="/plan" aria-current="page">Plan a trip</a>
        {columns.map((column) => (
          <a href={column.href}>{column.title}</a>
        ))}
      </nav>
      <div class="plan-intro">
        <Crumbs items={[{ name: 'Plan a trip' }]} />
        <h1>Plan a trip</h1>
        <p class="lede">Practical guides already on the site. Pick a column and open the page.</p>
      </div>
      <div class="plan-board">
        {columns.map((column) => {
          const shown = column.links.slice(0, shortSet);
          const extra = column.links.slice(shortSet);
          return (
            <section class="plan-card" id={column.id}>
              <h2><a href={column.href}>{column.title}</a></h2>
              <ul>
                {shown.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
              {extra.length > 0 && (
                <details class="plan-see">
                  <summary>See all <span aria-hidden="true">›</span></summary>
                  <ul>
                    {extra.map((item) => (
                      <li><a href={item.href}>{item.label}</a></li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          );
        })}
      </div>
      {news.length > 0 && (
        <section class="plan-news" aria-labelledby="plan-news-title">
          <h2 id="plan-news-title"><a href="/blog">Vietnam travel news</a></h2>
          <div class="plan-news-grid">
            {news.map((story) => (
              <a class="plan-news-card" href={story.href}>
                <span class="plan-news-photo">
                  <Photo id={story.photo} alt="" cover={story.cover} />
                </span>
                <strong>{story.title}</strong>
                <small><i aria-hidden="true"></i>{story.kicker}</small>
              </a>
            ))}
          </div>
          <a class="plan-more" href="/blog">More stories <span aria-hidden="true">›</span></a>
        </section>
      )}
    </div>
  </div>
</Base>
