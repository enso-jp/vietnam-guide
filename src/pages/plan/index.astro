---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getGuides, getItineraries } from '../../lib/content';
import { breadcrumbList } from '../../lib/schema';

const guides = getGuides();
const bySlug = new Map(guides.map((guide) => [guide.slug, guide]));
const link = (slug: string) => {
  const guide = bySlug.get(slug);
  return guide ? { href: `/plan/${guide.slug}`, label: guide.title } : null;
};
const before = ['when-to-go', 'e-visa', 'money', 'sim-and-wifi', 'luggage', 'street-manners', 'eating-manners']
  .map(link)
  .filter((item): item is { href: string; label: string } => Boolean(item));
const stay = ['where-to-stay'].map(link).filter((item): item is { href: string; label: string } => Boolean(item));
const travel = ['flights', 'trains', 'buses', 'grab-and-taxis', 'motorbikes']
  .map(link)
  .filter((item): item is { href: string; label: string } => Boolean(item));
const trips = getItineraries().filter((trip) => trip.level === 'nationwide' || trip.level === 'region');
const living = ['living', 'taxes'].map(link).filter((item): item is { href: string; label: string } => Boolean(item));
const columns = [
  {
    title: 'Before you go',
    links: [...before, { href: '/seasons', label: 'Seasons' }, { href: '/festivals', label: 'Festivals' }],
  },
  { title: 'Accommodation', links: stay },
  { title: 'Transportation', links: [...travel, { href: '/get-there', label: 'Routes between places' }] },
  {
    title: 'Itineraries',
    links: [...trips.map((trip) => ({ href: `/itineraries/${trip.slug}`, label: trip.title })), { href: '/itineraries', label: 'All itineraries' }],
  },
  { title: 'Living', links: living },
];
---
<Base title="Plan a trip" description="When to go, visas, where to stay, how to get around, itineraries, and living in Vietnam." path="/plan" jsonLd={breadcrumbList([{ name: 'Plan a trip', path: '/plan' }])}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Plan a trip' }]} />
    <h1>Plan a trip</h1>
    <p class="lede">Practical guides already on the site. Pick a column and open the page.</p>
    <div class="plan-columns">
      {columns.map((column) => (
        <section>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
