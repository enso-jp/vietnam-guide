---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getStories, pageDescription } from '../../lib/content';
import { breadcrumbList, itemList } from '../../lib/schema';

const stories = getStories();
const festivals = stories.filter((story) => story.kicker === 'Festival');
const seasons = stories.filter((story) => story.kicker === 'Season');
const description = pageDescription(
  'Festival dates and season notes from the places already on Vietnam Guide.',
  'A date that moves says check on arrival.',
);
---
<Base title="Travel news" description={description} path="/news" ogType="website" jsonLd={[itemList('Travel news', stories.map((story) => ({ name: story.title, path: story.href }))), breadcrumbList([{ name: 'Travel news', path: '/news' }])]}>
  <div class="wrap section">
    <Crumbs items={[{ name: 'Travel news' }]} />
    <h1>Travel news</h1>
    <p class="lede">Festival dates and season notes from places already on the site. A new city adds its note here. A date that moves says check on arrival.</p>
    <section class="place-section">
      <h2>Festivals</h2>
      <ul class="guide-list">
        {festivals.map((story) => (
          <li>
            <a class="guide-row" href={story.href}>
              <strong>{story.title}</strong>
              <p class="meta">{story.when}</p>
              <p>{story.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="place-section">
      <h2>Season notes</h2>
      <ul class="guide-list">
        {seasons.map((story) => (
          <li>
            <a class="guide-row" href={story.href}>
              <strong>{story.title}</strong>
              <p class="meta">{story.when}</p>
              <p>{story.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
