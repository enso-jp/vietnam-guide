---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import TripOtherStay from '../../components/TripOtherStay.astro';
import DiningMark from '../../components/DiningMark.astro';
import Photo from '../../components/Photo.astro';
import SectionNav from '../../components/SectionNav.astro';
import { getDishes, getFoodGuides, getPlace, pageDescription, placePath, placesForCityFood } from '../../lib/content';
import { photoPath } from '../../lib/photos';
import { article, breadcrumbList } from '../../lib/schema';
import type { Dish, FoodGuideRole, FoodSection, FoodSpot } from '../../lib/types';

export function getStaticPaths() {
  const dishes = getDishes().map((dish) => ({ params: { slug: dish.slug }, props: { kind: 'dish' as const, dish, guide: null, place: null } }));
  const guides = getFoodGuides().map((guide) => ({ params: { slug: guide.slug }, props: { kind: 'guide' as const, dish: null, guide, place: null } }));
  const places = placesForCityFood().map((place) => ({ params: { slug: place.slug }, props: { kind: 'place' as const, dish: null, guide: null, place } }));
  const slugs = new Set<string>();
  for (const entry of [...dishes, ...guides, ...places]) {
    if (slugs.has(entry.params.slug)) throw new Error(`Duplicate food slug ${entry.params.slug}`);
    slugs.add(entry.params.slug);
  }
  return [...dishes, ...guides, ...places];
}
const { kind, dish, guide, place } = Astro.props;
const city = kind === 'guide' ? getPlace(guide.placeSlug) : place;
const title = kind === 'dish' ? dish.seoTitle : kind === 'guide' ? guide.seoTitle : `${place.name} food`;
const description = kind === 'dish'
  ? pageDescription(dish.seoDescription, dish.summary, dish.origin)
  : kind === 'guide'
    ? pageDescription(guide.seoDescription, guide.summary, guide.body[0] || '')
    : pageDescription(place.eat[0] || place.summary, place.summary);
const path = `/food/${kind === 'dish' ? dish.slug : kind === 'guide' ? guide.slug : place.slug}`;
const image = kind === 'dish'
  ? (photoPath(dish.slug) || photoPath(city?.slug || ''))
  : kind === 'guide'
    ? (photoPath(guide.heroSlug || '') || photoPath(city?.slug || ''))
    : photoPath(city?.slug || '');
const crumbSchema = [
  { name: 'Food', path: '/food' },
  { name: kind === 'dish' ? dish.name : kind === 'guide' ? guide.name : `${place.name} food`, path },
];
const creditsPath = join(process.cwd(), 'public', 'photos', 'credits.json');
const credits: Record<string, { author?: string; license?: string }> = existsSync(creditsPath) ? JSON.parse(readFileSync(creditsPath, 'utf8')) : {};
function licensedId(id?: string) {
  if (!id || !photoPath(id)) return '';
  const credit = credits[id];
  return credit?.author && credit?.license ? id : '';
}
function dishWithPhoto(slug: string): Dish | null {
  const item = getDishes().find((entry) => entry.slug === slug);
  return item && licensedId(item.slug) ? item : null;
}
const foodRoles: FoodGuideRole[] = ['regional', 'international', 'casual', 'fine', 'themed', 'breakfast'];
const foodRoleLabel: Record<FoodGuideRole, string> = {
  regional: 'Regional dishes',
  international: 'International dining',
  casual: 'Casual dining',
  fine: 'Fine dining',
  themed: 'Themed dining',
  breakfast: 'Breakfast',
};
function sectionRole(section: FoodSection): FoodGuideRole | '' {
  return section.role && foodRoles.includes(section.role) ? section.role : '';
}
const specialtySource = kind === 'guide' && guide ? guide.dishSlugs : kind === 'place' && place ? place.dishSlugs : [];
const specialtyDishes = specialtySource.map(dishWithPhoto).filter((item): item is Dish => item !== null);
const heroId = kind === 'guide' && guide ? licensedId(guide.heroSlug) : '';
const heroCredit = heroId ? credits[heroId] : undefined;
const heroDish = heroId ? getDishes().find((entry) => entry.slug === heroId) : undefined;
const heroAlt = heroDish ? `${heroDish.name}, ${heroDish.nameVi}` : (guide?.name || 'Food');
const introLead = kind === 'guide' && guide ? guide.summary : kind === 'place' && place ? (place.eat[0] || place.summary) : '';
const introBody = kind === 'guide' && guide ? guide.body : kind === 'place' && place ? place.eat.slice(place.eat[0] ? 1 : 0) : [];
const specialtiesLead = kind === 'guide' && guide ? guide.specialtiesLead : '';
const specialtyTitle = city ? `${city.name} specialties` : 'Specialties';
type GuideBlock = {
  id: string;
  label: string;
  paragraphs: string[];
  dishes: Dish[];
  spots: FoodSpot[];
};
function guideBlock(section: FoodSection, label: string): GuideBlock | null {
  const paragraphs = (section.paragraphs || []).filter((line) => line.trim());
  const dishes = (section.dishSlugs || [])
    .filter((slug) => !(guide?.dishSlugs || []).includes(slug))
    .map((slug) => getDishes().find((entry) => entry.slug === slug) || null)
    .filter((item): item is Dish => item !== null);
  const spots = (section.spots || []).filter((spot) => spot.name);
  if (!paragraphs.length && !dishes.length && !spots.length) return null;
  return { id: section.id, label, paragraphs, dishes, spots };
}
const plainBlocks: GuideBlock[] = [];
const roleBlocks: GuideBlock[] = [];
if (kind === 'guide' && guide) {
  const sections = guide.sections || [];
  for (const section of sections) {
    if (sectionRole(section)) continue;
    const block = guideBlock(section, section.heading);
    if (block) plainBlocks.push(block);
  }
  for (const role of foodRoles) {
    for (const section of sections) {
      if (sectionRole(section) !== role) continue;
      const block = guideBlock(section, foodRoleLabel[role]);
      if (block) roleBlocks.push(block);
    }
  }
}
const guideBlocks = [...plainBlocks, ...roleBlocks];
const cityHref = kind === 'guide' && city ? placePath(city) : kind === 'place' && place ? `${placePath(place)}#eat` : '';
const dishSections = kind === 'dish' && dish ? [
  ...(dish.history?.length ? [{ id: 'history', label: 'History', paragraphs: dish.history }] : []),
  ...(dish.culture?.length ? [{ id: 'culture', label: 'Why it matters', paragraphs: dish.culture }] : []),
  ...(dish.texture?.length ? [{ id: 'texture', label: 'Texture', paragraphs: dish.texture }] : []),
  ...(dish.taste?.length ? [{ id: 'taste', label: 'Taste', paragraphs: dish.taste }] : []),
  ...(!dish.history?.length && !dish.culture?.length && !dish.texture?.length && !dish.taste?.length && dish.origin
    ? [{ id: 'origin', label: 'Where it comes from', paragraphs: [dish.origin] }]
    : []),
  ...(dish.howToEat.length ? [{ id: 'how-to-eat', label: 'How to enjoy it', paragraphs: dish.howToEat }] : []),
  { id: 'where', label: 'Where to try it', paragraphs: dish.where || [] },
] : [];
const secondPhoto = kind === 'dish' && dish && photoPath(`${dish.slug}-2`) ? `${dish.slug}-2` : '';
---
<Base title={title} description={description} path={path} jsonLd={[article(title, description, path, image), breadcrumbList(crumbSchema)]} ogImage={image}>
  <article class="wrap section">
    <Crumbs items={[{ name: 'Food', href: '/food' }, { name: crumbSchema[1].name }]} />
    {kind === 'dish' && dish && (
      <>
        <h1>{dish.name} <span class="vi" lang="vi">{dish.nameVi}</span></h1>
        <p class="lede">{dish.summary}</p>
        {photoPath(dish.slug) && (
          <figure class="food-hero">
            <Photo id={dish.slug} alt={`${dish.name}, ${dish.nameVi}`} priority={true} />
            {credits[dish.slug] && <figcaption>Photo: {credits[dish.slug].author} · {credits[dish.slug].license}</figcaption>}
          </figure>
        )}
        <div class="facts" style="--fact-cols: 2">
          <div><span>From</span><strong>{dish.origin.split('.')[0]}</strong></div>
          <div><span>Price</span><strong>{dish.priceBand}</strong></div>
        </div>
        {dish.verified && <p class="note">Facts verified {dish.verified}. Fees and hours change; confirm before you go.</p>}
        <SectionNav label={`${dish.name} sections`} items={dishSections.map((section) => ({ id: section.id, label: section.label }))} />
        <div class="reading place-body">
          {dishSections.map((section) => (
            <>
              {secondPhoto && section.id === 'how-to-eat' && (
                <figure class="food-hero">
                  <Photo id={secondPhoto} alt={`${dish.name}, ${dish.nameVi}`} />
                  {credits[secondPhoto] && <figcaption>Photo: {credits[secondPhoto].author} · {credits[secondPhoto].license}</figcaption>}
                </figure>
              )}
              <section id={section.id} class="place-section">
                <h2>{section.label}</h2>
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {section.id === 'where' && !(dish.where || []).length && <p>Cities where this dish is eaten.</p>}
                {section.id === 'where' && (
            <ul class="guide-list">
              {dish.placeSlugs.map((slug) => {
                const home = getPlace(slug);
                const hasFood = getFoodGuides().some((item) => item.slug === slug) || placesForCityFood().some((item) => item.slug === slug);
                return home ? (
                  <li>
                    <a class="guide-row" href={placePath(home)}><strong>{home.name}</strong></a>
                    {hasFood && <p><a href={`/food/${slug}`}>{home.name} food</a></p>}
                  </li>
                ) : null;
              })}
            </ul>
                )}
              </section>
            </>
          ))}
          {secondPhoto && !dishSections.some((section) => section.id === 'how-to-eat') && (
            <figure class="food-hero">
              <Photo id={secondPhoto} alt={`${dish.name}, ${dish.nameVi}`} />
              {credits[secondPhoto] && <figcaption>Photo: {credits[secondPhoto].author} · {credits[secondPhoto].license}</figcaption>}
            </figure>
          )}
        </div>
      </>
    )}
    {kind !== 'dish' && (
      <div class="place-grid food-guide">
        <div>
          <h1>{kind === 'guide' && guide ? guide.name : `${place?.name || 'City'} food`}</h1>
          {heroId && (
            <div class="place-photo">
              <Photo id={heroId} alt={heroAlt} priority={true} />
            </div>
          )}
          {heroCredit?.author && <p class="note photo-credit">Photo: {heroCredit.author} · {heroCredit.license}</p>}
          <div class="reading">
            <div class="food-intro" id="intro">
              {introLead && <p class="lede">{introLead}</p>}
              {introBody.map((paragraph) => <p>{paragraph}</p>)}
              {kind === 'guide' && guide?.verified && <p class="note">Facts verified {guide.verified}. Fees and hours change; confirm before you go.</p>}
            </div>
            {specialtyDishes.length > 0 && (
              <section id="specialties" class="place-section">
                <h2>{specialtyTitle}</h2>
                {specialtiesLead && <p>{specialtiesLead}</p>}
                <ul class="food-highlights">
                  {specialtyDishes.map((item) => (
                    <li><a href={`/food/${item.slug}`}>{item.name}</a></li>
                  ))}
                </ul>
                {specialtyDishes.map((item) => (
                  <article class="food-row">
                    <a class="food-row-photo" href={`/food/${item.slug}`}>
                      <Photo id={item.slug} alt={`${item.name}, ${item.nameVi}`} />
                    </a>
                    <div>
                      <h3><a href={`/food/${item.slug}`}>{item.name} <span class="vi" lang="vi">{item.nameVi}</span></a></h3>
                      <p>{item.summary}</p>
                    </div>
                  </article>
                ))}
              </section>
            )}
            {guideBlocks.map((block) => (
              <section id={block.id} class="place-section">
                <h2>{block.label}</h2>
                {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {block.dishes.map((item) => (
                  licensedId(item.slug) ? (
                    <article class="food-row">
                      <a class="food-row-photo" href={`/food/${item.slug}`}>
                        <Photo id={item.slug} alt={`${item.name}, ${item.nameVi}`} />
                      </a>
                      <div>
                        <h3><a href={`/food/${item.slug}`}>{item.name} <span class="vi" lang="vi">{item.nameVi}</span></a></h3>
                        <p>{item.summary}</p>
                      </div>
                    </article>
                  ) : (
                    <div class="spot">
                      <strong><a href={`/food/${item.slug}`}>{item.name}</a>{item.nameVi && <> <span class="vi" lang="vi">{item.nameVi}</span></>}</strong>
                      <p>{item.summary}</p>
                    </div>
                  )
                ))}
                {block.spots.map((spot) => {
                  const photo = licensedId(spot.photo);
                  return (
                    <article class="food-row">
                      <div class="food-row-photo">
                        {photo ? <Photo id={photo} alt={spot.name} /> : <DiningMark name={spot.name} />}
                      </div>
                      <div>
                        <h3>{spot.name}{spot.nameVi && <> <span class="vi" lang="vi">{spot.nameVi}</span></>}</h3>
                        {spot.address && <p class="spot-address">{spot.address}</p>}
                        {(spot.note || spot.caption) && <p>{spot.note || spot.caption}</p>}
                      </div>
                    </article>
                  );
                })}
              </section>
            ))}
            {cityHref && <p class="food-back"><a href={cityHref}>{city?.name} travel guide</a></p>}
          </div>
        </div>
        <aside class="rail">
          <div class="stay-box">
            <h2>Book your <em>stay</em></h2>
            <TripOtherStay />
          </div>
        </aside>
      </div>
    )}
  </article>
</Base>
