---
import { vietnamCities, vietnamRegions, vietnamViewBox } from '../lib/vietnam-map';

interface Props {
  variant?: 'compact' | 'home';
  active?: string;
  /** When false, regions are shapes only. Use this inside an existing anchor. */
  linked?: boolean;
}
const { variant = 'compact', active, linked = true } = Astro.props;
const showCities = variant === 'home';
const cityRegion: Record<string, string> = {
  sapa: 'northern-vietnam',
  'ha-giang': 'northern-vietnam',
  hanoi: 'northern-vietnam',
  'ha-long': 'northern-vietnam',
  'ninh-binh': 'northern-vietnam',
  'phong-nha': 'central-coast',
  hue: 'central-coast',
  'da-nang': 'central-coast',
  'hoi-an': 'central-coast',
  'nha-trang': 'highlands-coast',
  'da-lat': 'highlands-coast',
  'mui-ne': 'highlands-coast',
  'ho-chi-minh-city': 'southeast',
  'can-tho': 'mekong-delta',
  'phu-quoc': 'mekong-delta',
};
---
<svg
  class:list={['map-svg', 'map-vietnam', { 'map-compact': variant === 'compact' }]}
  viewBox={vietnamViewBox}
  aria-label="Map of Vietnam by travel corridor"
>
  {vietnamRegions.map((region) => {
    const on = region.slug === active;
    return linked ? (
      <a class:list={['map-hit', { 'is-active': on }]} href={`/destinations/${region.slug}`} data-region={region.slug}>
        <title>{region.name}</title>
        <path d={region.d} fill={region.fill}></path>
        <text class="map-region-name" x={region.label.x} y={region.label.y} text-anchor="middle">{region.name}</text>
      </a>
    ) : (
      <g class:list={[{ 'is-active': on }]} data-region={region.slug}>
        <title>{region.name}</title>
        <path d={region.d} fill={region.fill}></path>
      </g>
    );
  })}
  {showCities && (
    <g class="map-cities">
      {vietnamCities.map((city) => (
        <a class="map-city" href={`/${city.slug}`} data-region={cityRegion[city.slug]}>
          <title>{city.name}</title>
          <circle cx={city.x} cy={city.y} r="3.4"></circle>
          <text x={city.lx} y={city.ly} text-anchor={city.anchor}>{city.name}</text>
        </a>
      ))}
    </g>
  )}
</svg>
