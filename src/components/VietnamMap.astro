---
import { mapPins } from '../lib/map-pins';
import { vietnamIslandGroups, vietnamProvinceViewBox, vietnamProvinces, vietnamSeaLabels } from '../lib/vietnam-provinces';

interface Props {
  variant?: 'compact' | 'home';
  active?: string;
  /** When false, regions are shapes only. Use this inside an existing anchor. */
  linked?: boolean;
  /** When false, province names are not painted. Compact maps stay shapes only. */
  names?: boolean;
}
const { variant = 'compact', active, linked = true, names = true } = Astro.props;
const home = variant === 'home';
const mainlandViewBox = '68 8 276 530';
const pins = home && names ? mapPins(vietnamProvinces) : [];
const pinBySlug = new Map(pins.map((pin) => [pin.slug, pin]));
const southCentral = 'south-central-highlands';
const islandsOn = active === southCentral;
---
<svg
  class:list={['map-svg', 'map-vietnam', { 'map-home': home, 'map-compact': variant === 'compact', 'map-picked': Boolean(active) }]}
  viewBox={home ? vietnamProvinceViewBox : mainlandViewBox}
  preserveAspectRatio={home ? 'xMidYMin meet' : 'xMidYMid meet'}
  role="img"
  aria-label="Map of Vietnam by region"
>
  {vietnamProvinces.map((province) => {
    const on = province.region === active;
    const pin = pinBySlug.get(province.slug);
    const body = (
      <>
        <path d={province.d}></path>
        {pin && (
          <g class="map-pin" aria-hidden="true">
            <circle cx={pin.x} cy={pin.y} r="3.6"></circle>
            <text x={pin.lx} y={pin.ly} text-anchor={pin.anchor}>{pin.label}</text>
          </g>
        )}
      </>
    );
    return linked ? (
      <a
        class:list={['map-hit', 'map-province', { 'is-active': on }]}
        href={`/destinations/${province.region}`}
        data-region={province.region}
        data-province={province.name}
        data-corridor-name={province.regionName}
      >
        <title>{province.name}</title>
        {body}
      </a>
    ) : (
      <g
        class:list={['map-province', { 'is-active': on }]}
        data-region={province.region}
        data-province={province.name}
        data-corridor-name={province.regionName}
      >
        <title>{province.name}</title>
        {body}
      </g>
    );
  })}
  {home && (
    linked ? (
      <a
        class:list={['map-hit', 'map-islands', { 'is-active': islandsOn }]}
        href={`/destinations/${southCentral}`}
        data-region={southCentral}
        data-province="Hoang Sa and Truong Sa"
        data-corridor-name="South Central Coast & Central Highlands"
        aria-label="Hoang Sa (Vietnam) and Truong Sa (Vietnam)"
      >
        {vietnamIslandGroups.map((isle) => (
          <path class="map-isle" d={isle.d}></path>
        ))}
        {vietnamSeaLabels.map((label) => (
          <text class="map-sea-label" text-anchor="start">
            <tspan x={label.x} y={label.y}>{label.name}</tspan>
            <tspan x={label.x} dy="14">{label.note}</tspan>
          </text>
        ))}
      </a>
    ) : (
      <g class:list={['map-islands', { 'is-active': islandsOn }]} data-region={southCentral} aria-label="Hoang Sa (Vietnam) and Truong Sa (Vietnam)">
        {vietnamIslandGroups.map((isle) => (
          <path class="map-isle" d={isle.d}></path>
        ))}
        {vietnamSeaLabels.map((label) => (
          <text class="map-sea-label" text-anchor="start">
            <tspan x={label.x} y={label.y}>{label.name}</tspan>
            <tspan x={label.x} dy="14">{label.note}</tspan>
          </text>
        ))}
      </g>
    )
  )}
</svg>
