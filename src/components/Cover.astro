---
interface Props {
  variant?: string;
}
const { variant = 'karst' } = Astro.props;
const fills: Record<string, [string, string]> = {
  karst: ['#d5e4d4', '#1c1915'],
  lake: ['#d3e2ea', '#1f4e6b'],
  river: ['#e7efe4', '#8c2f2f'],
  coast: ['#d3e2ea', '#8f6a1f'],
  highlands: ['#e4ede4', '#1f4e6b'],
  delta: ['#e7efe4', '#5c564c'],
  city: ['#f6f3ec', '#1c1915'],
  town: ['#fffcf7', '#8c2f2f'],
};
const [wash, ink] = fills[variant] ?? fills.karst;
---
<div class="cover" data-cover={variant} aria-hidden="true">
  <svg viewBox="0 0 640 200" xmlns="http://www.w3.org/2000/svg">
    <rect width="640" height="200" fill={wash}></rect>
    {variant === 'karst' && (
      <g fill={ink} opacity="0.85">
        <path d="M40 160 L90 70 L140 160 Z"></path>
        <path d="M120 160 L190 40 L260 160 Z"></path>
        <path d="M230 160 L300 80 L370 160 Z"></path>
        <path d="M340 160 L420 55 L510 160 Z"></path>
      </g>
    )}
    {variant === 'lake' && <ellipse cx="320" cy="120" rx="220" ry="48" fill={ink} opacity="0.35"></ellipse>}
    {variant === 'river' && <path d="M0 90 C120 70 180 140 320 110 C460 80 520 150 640 100 L640 200 L0 200 Z" fill={ink} opacity="0.25"></path>}
    {variant === 'coast' && <path d="M0 120 C160 90 240 150 400 110 C500 86 560 140 640 100 L640 200 L0 200 Z" fill={ink} opacity="0.28"></path>}
    {variant === 'highlands' && (
      <g fill={ink} opacity="0.3">
        <path d="M0 150 L120 60 L240 150 L360 40 L520 150 L640 80 L640 200 L0 200 Z"></path>
      </g>
    )}
    {variant === 'delta' && (
      <g fill={ink} opacity="0.25">
        <path d="M80 20 C140 80 100 140 180 190" fill="none" stroke={ink} stroke-width="8"></path>
        <path d="M200 10 C240 90 180 150 280 190" fill="none" stroke={ink} stroke-width="6"></path>
        <path d="M340 30 C400 80 360 140 460 180" fill="none" stroke={ink} stroke-width="6"></path>
      </g>
    )}
    {(variant === 'city' || variant === 'town') && (
      <g fill={ink} opacity="0.8">
        <rect x="70" y="90" width="36" height="70"></rect>
        <rect x="120" y="60" width="28" height="100"></rect>
        <rect x="160" y="100" width="50" height="60"></rect>
        <rect x="230" y="74" width="22" height="86"></rect>
        <rect x="270" y="110" width="70" height="50"></rect>
        <rect x="360" y="80" width="30" height="80"></rect>
        <rect x="410" y="50" width="18" height="110"></rect>
        <rect x="450" y="96" width="80" height="64"></rect>
      </g>
    )}
  </svg>
</div>
