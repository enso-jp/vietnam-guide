---
const path = Astro.url.pathname;
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
const planOn = current('/plan') || current('/get-there') || current('/itineraries') || current('/seasons');
const interestOn = current('/interests') || current('/food');
---
<a class="skip" href="#content">Skip to content</a>
<header class="topbar">
  <div class="wrap bar">
    <a class="wordmark" href="/">Vietnam <span>Guide</span></a>
    <nav class="desk-nav" aria-label="Sections">
      <a href="/destinations" aria-current={current('/destinations')}>Destinations</a>
      <a href="/interests" aria-current={interestOn || undefined}>Interests</a>
      <a href="/plan" aria-current={planOn || undefined}>Plan a trip</a>
    </nav>
    <a class="desk-saved" href="/saved">Saved</a>
    <button class="bar-icon search-toggle" type="button" data-search-toggle aria-label="Search" aria-expanded="false" aria-controls="site-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="M16 16l4 4"></path></svg>
    </button>
  </div>
  <div id="site-search" class="search-pop" hidden>
    <form class="search-form wrap" action="/search" role="search">
      <label class="skip" for="q">Search</label>
      <input id="q" name="q" type="search" placeholder="Search places and routes" autocomplete="off" />
      <div id="search-panel" class="search-panel" hidden></div>
    </form>
  </div>
</header>
