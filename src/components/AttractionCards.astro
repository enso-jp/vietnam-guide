---
import AttractionCard from './AttractionCard.astro';
import type { Attraction } from '../lib/types';

interface Item {
  attraction: Attraction;
  rank: number;
}

interface Props {
  items: Item[];
  more?: Item[];
  fallbackId: string;
  cover: string;
}

const { items, more = [], fallbackId, cover } = Astro.props;
---
<div class="attraction-stack">
  <div class="card-list">
    {items.map(({ attraction, rank }) => (
      <AttractionCard attraction={attraction} rank={rank} fallbackId={fallbackId} cover={cover} />
    ))}
    {more.map(({ attraction, rank }) => (
      <AttractionCard attraction={attraction} rank={rank} fallbackId={fallbackId} cover={cover} extra />
    ))}
  </div>
  {more.length > 0 && (
    <button class="list-more" type="button" aria-expanded="false">
      <span class="list-more-closed">Show all</span>
      <span class="list-more-open">Show fewer</span>
    </button>
  )}
</div>
<noscript>
  <style>
    #attractions .is-extra { display: flex !important; }
    #attractions .list-more { display: none !important; }
  </style>
</noscript>
