---
interface Props {
  name?: string;
}
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'food' && <><path d="M6 10h12v2a6 6 0 0 1-12 0v-2z"/><path d="M8 10V7M12 10V6M16 10V7"/></>}
  {name === 'beach' && <><path d="M3 16c2.5-1.2 4.2-1.2 6.2 0s3.8 1.2 6.3 0 3.7-1.2 5.5 0"/><path d="M3 20c2.5-1.2 4.2-1.2 6.2 0s3.8 1.2 6.3 0 3.7-1.2 5.5 0"/><path d="M12 14V4M12 4c2 2 3 3.2 3 5"/></>}
  {name === 'drink' && <><path d="M8 3h8l-1 8a3 3 0 0 1-6 0L8 3zM12 14v5M9 21h6"/></>}
  {name === 'museum' && <><path d="M4 10h16M6 10v8M10 10v8M14 10v8M18 10v8M3 18h18M12 4l8 6H4l8-6z"/></>}
  {name === 'view' && <><path d="M3 18l5-6 4 4 3-3 6 5"/><path d="M14 7h5v5"/></>}
  {name === 'trip' && <><path d="M8 4h8v16H8zM8 8h8M8 12h5"/><path d="M12 2v2"/></>}
  {name === 'event' && <><path d="M5 6h14v14H5zM5 10h14M8 4v4M16 4v4"/></>}
  {name === 'pin' && <><path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z"/><path d="M12 11.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/></>}
  {name === 'bed' && <><path d="M4 18V8M4 14h16v4M8 14v-2a2 2 0 0 1 2-2h8v4"/></>}
  {name === 'plane' && <><path d="M3 12l18-6-4 14-4-5-5 3 1-6-6 0z"/></>}
  {name === 'car' && <><path d="M4 16v2M20 16v2M5 16h14l-1.5-5H6.5L5 16zM7 13l1-4h8l1 4"/><path d="M7.5 16.5h.1M16.5 16.5h.1"/></>}
  {name === 'bus' && <><path d="M5 6h14v10H5zM5 11h14M7 16v2M17 16v2M8 8h2M14 8h2"/></>}
  {name === 'flag' && <><path d="M6 20V4M6 5h11l-2 3 2 3H6"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="7"/><path d="M12 8.5V12l2.5 1.5"/></>}
  {name === 'ticket' && <path d="M4 8h16v3a2 2 0 0 0 0 2v3H4v-3a2 2 0 0 0 0-2V8zM9 8v8"/>}
</svg>
