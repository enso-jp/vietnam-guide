---
interface Item {
  name: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? <a href={item.href}>{item.name}</a> : <span>{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
