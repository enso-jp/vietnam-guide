---
interface Props {
  href: string;
  slug: string;
  title: string;
  duration: string;
  src?: string;
}

const { href, slug, title, duration, src } = Astro.props;
---
<a class:list={['itinerary-card', { 'is-plain': !src }]} href={href} data-slug={slug}>
  {src && <img src={src} alt="" width="960" height="640" loading="eager" decoding="async" />}
  <span class="itinerary-card-label">
    <strong>{title}</strong>
    <small>{duration}</small>
  </span>
</a>
