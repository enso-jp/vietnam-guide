---
interface Props {
  href: string;
  slug: string;
  title: string;
  duration?: string;
  src?: string;
  extra?: boolean;
}

const { href, slug, title, duration, src, extra = false } = Astro.props;
---
<a class:list={['itinerary-card', { 'is-plain': !src, 'is-extra': extra }]} href={href} data-slug={slug}>
  {src && <img src={src} alt="" width="960" height="640" loading="lazy" decoding="async" />}
  <span class="itinerary-card-label">
    <strong>{title}</strong>
    {duration && <small>{duration}</small>}
  </span>
</a>
