---
import VietnamMap from './VietnamMap.astro';
import { routeFrame, type RoutePin } from '../lib/route-map';

interface Props {
  pins: RoutePin[];
}
const { pins } = Astro.props;
const frame = routeFrame(pins);
const width = Number(frame.split(' ')[2]) || 276;
const radius = Math.round(width * 0.026 * 10) / 10;
const typeSize = Math.round(width * 0.04 * 10) / 10;
const line = pins.map((pin) => `${pin.x},${pin.y}`).join(' ');
const label = pins.map((pin) => `${pin.n}. ${pin.name}`).join(', ');
---
<figure class="route-map">
  <VietnamMap variant="compact" linked={false} names={false} viewBox={frame} />
  <svg class="route-overlay" viewBox={frame} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`Route: ${label}`}>
    {pins.length > 1 && <polyline points={line} stroke-width={radius * 0.28}></polyline>}
    {pins.map((pin) => (
      <g>
        <circle cx={pin.x} cy={pin.y} r={radius} stroke-width={radius * 0.22}></circle>
        <text class="route-num" x={pin.x} y={pin.y} text-anchor="middle" dominant-baseline="central" font-size={typeSize * 0.85}>{pin.n}</text>
        <text class="route-name" x={pin.anchor === 'start' ? pin.x + radius + 2 : pin.x - radius - 2} y={pin.labelY} text-anchor={pin.anchor} font-size={typeSize}>{pin.name}</text>
      </g>
    ))}
  </svg>
</figure>
